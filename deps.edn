{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.5"}}

 :aliases
 {:dogfood
  {:extra-paths ["dev"]
   :main-opts ["-m" "dj.ai.tooling.dogfood"]}

  :graph-builder
  {:extra-paths ["dev"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.5.1"}
                io.github.bmillare/dj.web
                {:git/sha "518b6fe21cf020af2cd21c27d2ac84707344c13c"}}
   :main-opts ["-m" "dj.ai.tooling.progress-builder"]}

  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.5.1"}}
   :extra-paths ["dev" "test"]
   :main-opts ["-m" "nrepl.cmdline"]}

  :test
  {:extra-paths ["dev" "test"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.5.1"}
                io.github.bmillare/dj.web
                {:git/sha "518b6fe21cf020af2cd21c27d2ac84707344c13c"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.clojure/data.json {:mvn/version "2.5.2"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
          slipset/deps-deploy             {:mvn/version "0.2.2"}}
   :ns-default build}}}
