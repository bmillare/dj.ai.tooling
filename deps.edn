{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.5"}
  org.clojure/data.json {:mvn/version "2.5.2"}}

 :aliases
 {:payload-api
  {:extra-paths ["dev"]
   :main-opts ["-m" "dj.ai.tooling.payload-api"]}

  :local-api
  {:extra-paths ["dev"]
   :main-opts ["-m" "dj.ai.tooling.local-api"]}

  :dogfood
  {:extra-paths ["dev"]
   :main-opts ["-m" "dj.ai.tooling.dogfood"]}

  :graph-builder
  {:extra-paths ["dev"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.5.1"}
                io.github.bmillare/dj.recorder
                {:git/sha "059665e657e8d3d7d0ff25b8a2b8b2fa5e5845e9"}
                io.github.bmillare/dj.web
                {:git/sha "518b6fe21cf020af2cd21c27d2ac84707344c13c"}
                ;; Focused flexmark modules for markdown node bodies
                ;; (flexmark-all also pulls in PDF tooling). The URL gate in
                ;; dj.ai.tooling.markdown is part of the safety contract.
                com.vladsch.flexmark/flexmark {:mvn/version "0.64.8"}
                com.vladsch.flexmark/flexmark-ext-tables {:mvn/version "0.64.8"}
                com.vladsch.flexmark/flexmark-ext-gfm-strikethrough {:mvn/version "0.64.8"}
                com.vladsch.flexmark/flexmark-ext-autolink {:mvn/version "0.64.8"}}
   :main-opts ["-m" "dj.ai.tooling.progress-builder"]}

  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.5.1"}}
   :extra-paths ["dev" "test"]
   :main-opts ["-m" "nrepl.cmdline"]}

  :test
  {:extra-paths ["dev" "test"]
   :jvm-opts ["-Ddj.ai.tooling.progress.path=target/progress-builder-test.edn"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.5.1"}
                io.github.bmillare/dj.recorder
                {:git/sha "059665e657e8d3d7d0ff25b8a2b8b2fa5e5845e9"}
                io.github.bmillare/dj.web
                {:git/sha "518b6fe21cf020af2cd21c27d2ac84707344c13c"}
                com.vladsch.flexmark/flexmark {:mvn/version "0.64.8"}
                com.vladsch.flexmark/flexmark-ext-tables {:mvn/version "0.64.8"}
                com.vladsch.flexmark/flexmark-ext-gfm-strikethrough {:mvn/version "0.64.8"}
                com.vladsch.flexmark/flexmark-ext-autolink {:mvn/version "0.64.8"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
          slipset/deps-deploy             {:mvn/version "0.2.2"}}
   :ns-default build}}}
